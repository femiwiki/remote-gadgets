local p = {}

--- root/id 문서가 있는지 확인합니다.
-- 확인한 문서는 이 모듈을 부른 문서가 링크한 것으로 기록됩니다.
-- 그래서 없던 문서가 새로 만들어지면 부른 문서의 캐시가 비워져, 새 포스트가 자동으로 목록에 나타납니다.
local function exists( root, id )
	return mw.title.new( root .. '/' .. id ).exists
end

--- 마지막 포스트의 id를 찾습니다.
-- 1, 2, 4, 8, ...로 두 배씩 늘리며 없는 번호를 찾은 뒤 그 사이를 이진 탐색합니다.
-- 지수 탐색: https://en.wikipedia.org/wiki/Exponential_search
-- 중간 번호가 비어 있으면 그 앞 번호를 마지막으로 여길 수 있습니다.
-- @param root 포스트들의 공통된 문서 제목 부분, '/'는 포함 안 함.
-- @return number 마지막 포스트의 id, 포스트가 없으면 0
local function findLastId( root )
	if not exists( root, 1 ) then
		return 0
	end

	-- lo는 있는 번호, hi는 없는 번호입니다.
	local lo, hi = 1, 2
	while exists( root, hi ) do
		lo, hi = hi, hi * 2
	end
	while hi - lo > 1 do
		local mid = math.floor( ( lo + hi ) / 2 )
		if exists( root, mid ) then
			lo = mid
		else
			hi = mid
		end
	end
	return lo
end

--- 최근 블로그 포스트들을 보여줍니다.
-- @param frame.args['root'] 포스트들의 공통된 문서 제목 부분, '/'는 포함 안 함.
-- @param frame.args['limit'] 보여줄 최다 포스트 수, 없으면 5
-- @return string wikitext
function p.renderPosts( frame )
	local root = frame.args['root']
	local limit = tonumber( frame.args['limit'] ) or 5

	local posts = ''
	local count = 0
	for id = findLastId( root ), 1, -1 do
		if exists( root, id ) then
			posts = posts .. frame:expandTemplate{ title = root .. '/' .. id }

			count = count + 1
			if count >= limit then break end
		end
	end

	local ul = mw.html.create( 'ul' ):addClass( 'blog-posts' ):wikitext( posts )
	return tostring( ul )
end

--- 포스트 문서의 {{페미위키 블로그 포스트}}에 적힌 title과 date 값을 읽습니다.
-- @param text 포스트 문서의 내용
-- @param id 포스트의 id, 제목을 찾지 못할 때 대신 씁니다.
-- @return string 제목, 찾지 못하면 id
-- @return string|nil 날짜, 찾지 못하면 nil
local function postInfo( text, id )
	local title = text:match( '|%s*title%s*=([^\n|]*)' )
	local date = text:match( '|%s*date%s*=([^\n|]*)' )
	return title and mw.text.trim( title ) or tostring( id ),
		date and mw.text.trim( date )
end

--- 최근 포스트들의 제목과 날짜를 최신순 링크 목록으로 만듭니다.
-- 목차에 끼어드는 제목 태그 없이 링크만 냅니다.
-- @param root 포스트들의 공통된 문서 제목 부분, '/'는 포함 안 함.
-- @param limit 보여줄 최다 포스트 수, nil이면 전부
-- @param exclude 목록에서 뺄 포스트의 id, nil이면 빼지 않음
-- @return string wikitext
local function titleList( root, limit, exclude )
	local lang = mw.language.getContentLanguage()
	local items = {}
	for id = findLastId( root ), 1, -1 do
		-- 제목과 날짜를 읽으려고 내용을 가져오며, 없는 번호는 내용이 nil이라 여기서 걸러집니다.
		-- exists로 따로 확인하지 않으므로 비싼 파서 함수 한도가 포스트 수를 제한하지 않습니다.
		local text = id ~= exclude and mw.title.new( root .. '/' .. id ):getContent()
		if text then
			local title, date = postInfo( text, id )
			local item = '* [[' .. root .. '/' .. id .. '|' .. title .. ']]'
			-- 날짜가 잘못 적혀 있어도 목록 전체가 오류가 되지 않게, 날짜만 뺍니다.
			local ok, formatted = pcall( lang.formatDate, lang, 'Y년 n월 j일', date or '', true )
			if date and ok then
				item = item .. ' <span class="femiwiki-blog-list--date">' .. formatted .. '</span>'
			end
			table.insert( items, item )
			if limit and #items >= limit then break end
		end
	end
	return table.concat( items, '\n' )
end

--- 최근 포스트들의 제목과 날짜를 링크 목록으로 보여줍니다. 포스트 아래 꼬리말에 씁니다.
-- @param frame.args['root'] 포스트들의 공통된 문서 제목 부분, '/'는 포함 안 함.
-- @param frame.args['limit'] 보여줄 최다 포스트 수, 없으면 3
-- @param frame.args['exclude'] 목록에서 뺄 포스트의 id, 보통 지금 포스트
-- @return string wikitext
function p.renderTitles( frame )
	return titleList(
		frame.args['root'],
		tonumber( frame.args['limit'] ) or 3,
		tonumber( frame.args['exclude'] )
	)
end

--- 모든 포스트의 제목과 날짜를 링크 목록으로 보여줍니다. 전체 보기 문서에 씁니다.
-- @param frame.args['root'] 포스트들의 공통된 문서 제목 부분, '/'는 포함 안 함.
-- @return string wikitext
function p.renderArchive( frame )
	return titleList( frame.args['root'] )
end

--- 마지막 포스트의 id를 돌려줍니다.
-- @param frame.args['root'] 포스트들의 공통된 문서 제목 부분, '/'는 포함 안 함.
-- @return number 마지막 포스트의 id
function p.findLastId( frame )
	local root = frame.args['root']
	if root == nil then error( 'root must be declared' ) end
	return findLastId( root )
end

--- 포스트 문서의 {{페미위키 블로그 포스트}}에 적힌 값 하나를 읽습니다.
-- @param text 포스트 문서의 내용
-- @param name 매개변수 이름
-- @return string|nil 값, 없거나 비어 있으면 nil
local function postField( text, name )
	local value = text:match( '|%s*' .. name .. '%s*=([^\n]*)' )
	value = value and mw.text.trim( value )
	if value == '' then
		return nil
	end
	return value
end

-- 피드 주소의 쿼리입니다. 피드 문서를 틀까지 펼친 원문으로 받고, 서버 캐시가 한 시간 들고 있게 합니다.
-- 코어는 이런 raw 응답에 s-maxage=0을 붙여서, smaxage가 없으면 받을 때마다 다시 만듭니다.
-- action=raw의 templates=expand는 미디어위키 코어 기능입니다.
-- https://www.mediawiki.org/wiki/Manual:Parameters_to_index.php#Raw
local FEED_QUERY = 'action=raw&templates=expand&smaxage=3600'

--- 요약의 위키 문법을 피드에 넣을 평문으로 바꿉니다.
-- Scribunto에는 이런 함수가 없어서, 요약에 쓸 만한 문법만 다룹니다.
-- 링크는 보이는 글자만 남기고, 굵게와 기울임 따옴표를 뺍니다.
-- @param text 위키 문법
-- @return string 평문
local function plainText( text )
	text = text:gsub( '%[%[[^%]|]*|([^%]]*)%]%]', '%1' )
	text = text:gsub( '%[%[([^%]]*)%]%]', '%1' )
	text = text:gsub( '%[https?://%S+%s+([^%]]*)%]', '%1' )
	text = text:gsub( "'''?", '' )
	return text
end

--- XML에 넣을 수 있게 특수 문자를 바꿉니다.
-- @param text 평문
-- @return string
local function xml( text )
	return mw.text.encode( text, '<>&"' )
end

--- 날짜를 Atom이 쓰는 RFC 3339 형식으로 바꿉니다.
-- @param date 포스트 틀의 date 값
-- @return string|nil 바꾼 날짜, 읽을 수 없으면 nil
local function rfc3339( date )
	if not date then
		return nil
	end
	local lang = mw.language.getContentLanguage()
	local ok, formatted = pcall( lang.formatDate, lang, 'c', date )
	if ok then
		return formatted
	end
	return nil
end

--- 피드 문서를 문서 ID로 받는 주소를 만듭니다.
-- 문서 이름 대신 ID를 써서 주소가 짧고, 문서를 옮겨도 그대로 쓸 수 있습니다.
-- @param title 피드 문서의 mw.title 객체
-- @return string 주소
local function feedAddress( title )
	local uri = mw.uri.canonicalUrl( title.prefixedText )
	return uri.protocol .. '://' .. uri.host .. mw.site.scriptPath ..
		'/index.php?curid=' .. title.id .. '&' .. FEED_QUERY
end

--- 포스트 그림의 섬네일 주소를 만듭니다.
-- 특수:파일경로가 그림 서버의 섬네일로 넘겨 주므로, 피드 리더는 글 문서를 따로 읽지 않고 그림을 받습니다.
-- @param file 파일 이름, '파일:'은 포함 안 함.
-- @return string 주소
local function thumbnailUrl( file )
	return tostring( mw.uri.canonicalUrl( 'Special:FilePath/' .. file, { width = 640 } ) )
end

--- 피드 문서의 주소를 돌려줍니다. 블로그 대문의 구독 링크에 씁니다.
-- @param frame.args['page'] 피드 문서의 이름
-- @return string 주소
function p.feedUrl( frame )
	return feedAddress( mw.title.new( frame.args['page'] ) )
end

--- 최근 포스트들을 Atom 피드로 만듭니다.
-- 피드 문서에서 부르고, 그 문서를 p.feedUrl의 주소로 받으면 XML이 나옵니다.
-- 제목, 발행일, 요약, 글쓴이, 섬네일은 포스트 문서의 {{페미위키 블로그 포스트}}에서 읽습니다.
-- 날짜가 없거나 잘못된 포스트는 뺍니다.
-- @param frame.args['root'] 포스트들의 공통된 문서 제목 부분, '/'는 포함 안 함.
-- @param frame.args['title'] 피드 제목, 없으면 root
-- @param frame.args['limit'] 넣을 최다 포스트 수, 없으면 20
-- @return string Atom XML
function p.atom( frame )
	local root = frame.args['root']
	if root == nil then error( 'root must be declared' ) end
	local feedTitle = frame.args['title'] or root
	local limit = tonumber( frame.args['limit'] ) or 20
	local rootUrl = mw.title.new( root ):canonicalUrl()
	local selfUrl = feedAddress( mw.title.getCurrentTitle() )

	local now = rfc3339( 'now' )
	local entries = {}
	local updated
	for id = findLastId( root ), 1, -1 do
		local post = mw.title.new( root .. '/' .. id )
		local text = post:getContent()
		local published = text and rfc3339( postField( text, 'date' ) )
		-- 발행일이 오지 않은 포스트는 아직 넣지 않습니다.
		if published and published <= now then
			local url = post:canonicalUrl()
			local entry = {
				'<entry>',
				'<title>' .. xml( postField( text, 'title' ) or tostring( id ) ) .. '</title>',
				'<link rel="alternate" type="text/html" href="' .. xml( url ) .. '"/>',
				'<id>' .. xml( url ) .. '</id>',
				'<published>' .. published .. '</published>',
				'<updated>' .. published .. '</updated>',
			}
			local author = postField( text, 'author' )
			if author then
				table.insert( entry, '<author><name>' .. xml( author ) .. '</name></author>' )
			end
			local summary = postField( text, 'summary' )
			if summary then
				table.insert( entry, '<summary>' .. xml( plainText( summary ) ) .. '</summary>' )
			end
			local thumb = postField( text, 'thumb' ) or postField( text, 'hero' )
			if thumb then
				table.insert( entry, '<media:thumbnail url="' .. xml( thumbnailUrl( thumb ) ) .. '"/>' )
			end
			table.insert( entry, '</entry>' )
			table.insert( entries, table.concat( entry, '\n' ) )
			-- RFC 3339 날짜는 모두 UTC로 바뀌어 있어 글자로 비교해도 순서가 맞습니다.
			if not updated or published > updated then
				updated = published
			end
			if #entries >= limit then break end
		end
	end

	local lang = mw.language.getContentLanguage()
	return table.concat( {
		'<?xml version="1.0" encoding="utf-8"?>',
		'<feed xmlns="http://www.w3.org/2005/Atom" xmlns:media="http://search.yahoo.com/mrss/" xml:lang="' .. lang:getCode() .. '">',
		'<title>' .. xml( feedTitle ) .. '</title>',
		'<link rel="alternate" type="text/html" href="' .. xml( rootUrl ) .. '"/>',
		'<link rel="self" type="application/atom+xml" href="' .. xml( selfUrl ) .. '"/>',
		'<id>' .. xml( rootUrl ) .. '</id>',
		'<updated>' .. ( updated or now ) .. '</updated>',
		table.concat( entries, '\n' ),
		'</feed>',
	}, '\n' )
end

return p
